RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_MCP_ENABLED=false
RAZORPAY_MCP_TRANSPORT=stdio
RAZORPAY_MCP_DOCKER_IMAGE=razorpay-mcp-server:latest
RAZORPAY_MCP_DOCKER_COMMAND=docker

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Jev decision model via OpenRouter (judgments as probabilities). Empty key =
# every judgment falls back to the keyword / LLM path.
OPEN_ROUTER=
JEV_MODEL=typesafe/jev-1.13-20260917

LIVE_MODE=false

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

VAPI_API_KEY=

CORS_ORIGINS=http://localhost:3000

ENCRYPTION_KEY=generate_with_Fernet.generate_key()

# Global cap on billable API calls per IST calendar day (all callers combined).
# /api/v1/health, CORS preflight, docs routes and Razorpay webhooks are exempt.
RATE_LIMIT_ENABLED=true
DAILY_REQUEST_LIMIT=200
